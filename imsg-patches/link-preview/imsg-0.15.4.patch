+import Foundation
+import Testing
+
+@testable import IMsgCore
+
+/// Stand-ins with the same archived shape as Messages' RichLink and LPLinkMetadata:
+/// plain keyed objects, not NSDictionary, so the decoder walks the same structure.
+@objc(IMsgTestSyntheticRichLink)
+private final class SyntheticRichLink: NSObject, NSCoding {
+  let metadata: SyntheticLinkMetadata
+  init(metadata: SyntheticLinkMetadata) { self.metadata = metadata }
+  required init?(coder: NSCoder) { nil }
+  func encode(with coder: NSCoder) {
+    coder.encode(false, forKey: "richLinkIsPlaceholder")
+    coder.encode(metadata, forKey: "richLinkMetadata")
+  }
+}
+
+@objc(IMsgTestSyntheticImageSubstitute)
+private final class SyntheticImageSubstitute: NSObject, NSCoding {
+  required init?(coder: NSCoder) { nil }
+  override init() {}
+  func encode(with coder: NSCoder) {
+    coder.encode(1, forKey: "richLinkImageAttachmentSubstituteIndex")
+    coder.encode("image/jpeg", forKey: "MIMEType")
+  }
+}
+
+@objc(IMsgTestSyntheticLinkMetadata)
+private final class SyntheticLinkMetadata: NSObject, NSCoding {
+  required init?(coder: NSCoder) { nil }
+  override init() {}
+  func encode(with coder: NSCoder) {
+    coder.encode(NSURL(string: "https://example.invalid/article"), forKey: "URL")
+    coder.encode(NSURL(string: "https://example.invalid/a"), forKey: "originalURL")
+    coder.encode("  Synthetic title ", forKey: "title")
+    coder.encode("Synthetic summary", forKey: "summary")
+    coder.encode("", forKey: "siteName")
+    coder.encode(SyntheticImageSubstitute(), forKey: "image")
+  }
+}
+
+@Test
+func decodesStoredLinkPreviewFields() throws {
+  let data = try NSKeyedArchiver.archivedData(
+    withRootObject: SyntheticRichLink(metadata: SyntheticLinkMetadata()),
+    requiringSecureCoding: false
+  )
+  let preview = try #require(LinkPreviewDecoder.decode(data, balloonRowID: 7))
+  #expect(preview.balloonRowID == 7)
+  #expect(preview.url == "https://example.invalid/article")
+  #expect(preview.originalURL == "https://example.invalid/a")
+  #expect(preview.title == "Synthetic title")
+  #expect(preview.summary == "Synthetic summary")
+  #expect(preview.siteName == nil)
+  #expect(preview.imageAttachmentIndex == 1)
+  #expect(preview.imageMIMEType == "image/jpeg")
+}
+
+@Test
+func ignoresPayloadsWithoutLinkMetadata() throws {
+  let other = try NSKeyedArchiver.archivedData(
+    withRootObject: ["somethingElse": "x"], requiringSecureCoding: false)
+  #expect(LinkPreviewDecoder.decode(other, balloonRowID: 1) == nil)
+  #expect(LinkPreviewDecoder.decode(Data("not a plist".utf8), balloonRowID: 1) == nil)
+  #expect(LinkPreviewDecoder.decode(Data(), balloonRowID: 1) == nil)
+  let oversized = Data(count: LinkPreviewDecoder.maxPayloadBytes + 1)
+  #expect(LinkPreviewDecoder.decode(oversized, balloonRowID: 1) == nil)
+}
