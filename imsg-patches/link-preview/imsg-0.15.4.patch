+
+/// Local patch (link-preview): the preview Messages stored with a link. The
+/// image is described only when attachments were requested, like any attachment.
+func linkPreviewPayload(
+  store: MessageStore,
+  message: Message,
+  includeAttachments: Bool
+) throws -> [String: Any]? {
+  guard let preview = try store.linkPreview(for: message) else { return nil }
+  var payload: [String: Any] = [:]
+  payload["url"] = preview.url
+  payload["original_url"] = preview.originalURL
+  payload["title"] = preview.title
+  payload["summary"] = preview.summary
+  payload["site_name"] = preview.siteName
+  if includeAttachments, let index = preview.imageAttachmentIndex, index >= 0 {
+    let metas = try store.attachments(for: preview.balloonRowID)
+    if index < metas.count {
+      var image = attachmentPayload(metas[index])
+      if metas[index].mimeType.isEmpty, let mimeType = preview.imageMIMEType {
+        image["mime_type"] = mimeType
+      }
+      payload["image"] = image
+    }
+  }
+  return payload
 }
