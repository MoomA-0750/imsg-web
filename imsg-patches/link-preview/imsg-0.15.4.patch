+import Foundation
+import SQLite
+
+/// The link preview Messages stored with a URL balloon: title, summary, site
+/// name and which of the balloon's attachments is the preview image. It is
+/// decoded from `message.payload_data` only; nothing is fetched from the network.
+public struct LinkPreview: Sendable, Equatable {
+  /// ROWID of the balloon message that owns the preview and its attachments.
+  public let balloonRowID: Int64
+  public let url: String?
+  public let originalURL: String?
+  public let title: String?
+  public let summary: String?
+  public let siteName: String?
+  public let imageAttachmentIndex: Int?
+  public let imageMIMEType: String?
+}
+
+enum LinkPreviewDecoder {
+  static let maxPayloadBytes = 512 * 1024
+
+  /// Walks the keyed archive by hand along the few known keys. Nothing is
+  /// unarchived into objects, and no generic resolver is used: a dictionary
+  /// whose description merely mentions a UID must not be taken for one.
+  static func decode(_ data: Data, balloonRowID: Int64) -> LinkPreview? {
+    guard !data.isEmpty, data.count <= maxPayloadBytes,
+      let archive = try? PropertyListSerialization.propertyList(from: data, options: [], format: nil)
+        as? [String: Any],
+      let objects = archive["$objects"] as? [Any],
+      let top = archive["$top"] as? [String: Any]
+    else { return nil }
+    func object(_ reference: Any?) -> Any? {
+      guard let reference, let index = uid(reference), index > 0, index < objects.count else {
+        return nil
+      }
+      return objects[index]
+    }
+    func string(_ reference: Any?) -> String? {
+      guard let value = object(reference) as? String else { return nil }
+      let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+      return trimmed.isEmpty ? nil : trimmed
+    }
+    func url(_ reference: Any?) -> String? {
+      guard let dict = object(reference) as? [String: Any] else { return nil }
+      guard let relative = string(dict["NS.relative"]) else { return nil }
+      if let base = string(dict["NS.base"]), let baseURL = URL(string: base) {
+        return URL(string: relative, relativeTo: baseURL)?.absoluteString
+      }
+      return relative
+    }
+    guard let root = object(top["root"]) as? [String: Any],
+      let metadata = object(root["richLinkMetadata"]) as? [String: Any]
+    else { return nil }
+    let image = object(metadata["image"]) as? [String: Any]
+    let preview = LinkPreview(
+      balloonRowID: balloonRowID,
+      url: url(metadata["URL"]),
+      originalURL: url(metadata["originalURL"]),
+      title: string(metadata["title"]),
+      summary: string(metadata["summary"]),
+      siteName: string(metadata["siteName"]),
+      imageAttachmentIndex: (image?["richLinkImageAttachmentSubstituteIndex"] as? NSNumber)?.intValue,
+      imageMIMEType: string(image?["MIMEType"])
+    )
+    guard preview.url != nil || preview.originalURL != nil || preview.title != nil else { return nil }
+    return preview
+  }
+
+  /// The index a CFKeyedArchiverUID points at. Foundation exposes no Swift type
+  /// for it, so it is recognised by its own description and nothing else.
+  private static func uid(_ value: Any) -> Int? {
+    if value is String || value is [Any] || value is [String: Any] || value is NSNumber
+      || value is Data || value is Date
+    {
+      return nil
+    }
+    let description = String(describing: value)
+    guard description.hasPrefix("<CFKeyedArchiverUID"),
+      let marker = description.range(of: "{value = "),
+      let end = description[marker.upperBound...].firstIndex(of: "}")
+    else { return nil }
+    return Int(description[marker.upperBound..<end])
+  }
+}
+
+extension MessageStore {
+  /// The stored link preview for a message that is a URL balloon or was
+  /// coalesced with one, or nil.
+  public func linkPreview(for message: Message) throws -> LinkPreview? {
+    guard schema.hasPayloadDataColumn, schema.hasBalloonBundleIDColumn else { return nil }
+    let rowID: Int64
+    if let preview = message.urlPreview {
+      rowID = preview.rowID
+    } else if message.balloonBundleID == MessageStore.urlPreviewBalloonBundleID {
+      rowID = message.rowID
+    } else {
+      return nil
+    }
+    return try withConnection { db in
+      let rows = try db.prepareRowIterator(
+        "SELECT payload_data FROM message WHERE ROWID = ? AND balloon_bundle_id = ?",
+        bindings: [rowID, MessageStore.urlPreviewBalloonBundleID]
+      )
+      guard let row = try rows.failableNext() else { return nil }
+      return LinkPreviewDecoder.decode(try dataValue(row, "payload_data"), balloonRowID: rowID)
+    }
+  }
+}
