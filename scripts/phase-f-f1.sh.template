#!/bin/sh
# Phase F / F1 — the first execution of a built product. `--version` only.
#
# Generated by scripts/gen-phase-f.mjs. Neither the probe generator (which
# forbids every write) nor the Phase D generator (which forbids executing the
# product) can produce this: F1's whole purpose is to run the artifact once.
#
# Contract, enforced by the Phase F generator:
#   - exactly one execution, of exactly the product path passed to the generator
#   - that execution goes through `/usr/bin/env -i` with a fixed variable list,
#     so nothing from the SSH session leaks in. Prefix assignments would only
#     override, leaving SSH_CONNECTION set -- and `isSSH` changes which contact
#     source imsg uses, so "override" is not good enough for fidelity.
#   - no writes of any kind. No mkdir, no touch, no redirection.
#   - `--version` and nothing else. No `rpc`, no `status`, no `--db`.
#
# Why this is the narrowest rung: CommandRouter returns for `--version` before
# resolving the command, so no MessageStore, no ContactResolver and no bridge
# client is constructed. Confirmed by reading the pinned source, not assumed.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

PRODUCT='@@PRODUCT@@'
RUNHOME='@@RUNHOME@@'
RUNTMP='@@RUNTMP@@'
RUNCWD='@@RUNCWD@@'
ROLE='@@ROLE@@'

echo "== phase-f f1 begin"
echo "role: ${ROLE}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== pre product identity"
stat -L -f "%Sp %Su:%Sg %z %Sm %N" "${PRODUCT}"
shasum -a 256 "${PRODUCT}"
file -bL "${PRODUCT}"
# Gatekeeper acts only on files carrying a quarantine attribute. A locally built
# product should have none; one that had been moved through Finder or AirDrop
# would.
xattr -l "${PRODUCT}"
echo "xattr exit: $?"
# Apple Silicon refuses to execute unsigned native arm64 code, so the linker
# ad-hoc signs there. A one-byte change after that is a SIGKILL rather than a
# diagnosable failure, which makes verifying before the first run worth doing.
codesign --verify --verbose "${PRODUCT}" 2>&1
echo "codesign verify exit: $?"

echo "== pre bridge ready lock (three-valued)"
# present / absent / unreadable. "Unreadable" is never recorded as "absent":
# that is the command -v mistake from Phase A, where a probe whose failure mode
# was already known had its negative result read as evidence.
LOCK="${HOME}/Library/Containers/com.apple.MobileSMS/Data/.imsg-bridge-ready"
if [ -e "${LOCK}" ]; then
  echo "ready lock: PRESENT"
  stat -f "%Sm %N" "${LOCK}"
elif [ -r "${HOME}/Library/Containers/com.apple.MobileSMS/Data" ]; then
  echo "ready lock: absent (container readable)"
else
  echo "ready lock: UNREADABLE (container not readable - not the same as absent)"
fi

echo "== pre process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== pre crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== RUN"
date -u "+%Y-%m-%dT%H:%M:%SZ"
# env -i, not prefix assignments: the latter override but do not remove, and
# SSH_CONNECTION surviving would flip imsg onto its SSH contact-source branch.
/usr/bin/env -i HOME="${RUNHOME}" PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${RUNTMP}" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 "${PRODUCT}" --version < /dev/null
echo "product exit: $?"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== post process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== post crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== post TCC log"
# Full Disk Access never prompts -- it is silently denied -- so the unified log
# is the only way to see it from an SSH session.
log show --last 3m --predicate 'subsystem == "com.apple.TCC"' --style compact
echo "log exit: $?"

echo "== phase-f f1 end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
