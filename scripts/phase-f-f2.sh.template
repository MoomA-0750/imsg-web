#!/bin/sh
# Phase F / F2 — one `status` request against a SYNTHETIC database, then EOF.
#
# Generated by scripts/gen-phase-f.mjs. Exactly one execution, in one shape.
#
# Two things this rung must get right, both found by review rather than by
# writing it:
#
#   * stdin must NOT be a terminal. `RpcCommand.startupContactsAccessPolicy`
#     selects `.requestIfNeeded` when stdin is a TTY, and `ContactResolver`
#     calls `requestAccess` when the status is notDetermined, the policy is
#     requestIfNeeded, and isSSH is false. The Phase C allow-list drops
#     SSH_CONNECTION, so isSSH is false BECAUSE of this project's own
#     environment contract. Non-TTY stdin is the only remaining guard, and the
#     here-document below supplies it.
#   * `--db` moves the database, not the run. `status` always stats
#     <container>/.imsg-bridge-ready, and would do IPC if it were present. This
#     rung runs only where that lock is absent.
#
# `contacts.available: false` is REQUIRED in the response. `true` would mean the
# address book was enumerated, and the owner's contacts are the owner's data.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

PRODUCT='@@PRODUCT@@'
RUNHOME='@@RUNHOME@@'
RUNTMP='@@RUNTMP@@'
RUNCWD='@@RUNCWD@@'
FIXTURE='@@FIXTURE@@'
ROLE='@@ROLE@@'

echo "== phase-f f2 begin"
echo "role: ${ROLE}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== pre fixture"
stat -f "%Sp %Su:%Sg %z %N" "${FIXTURE}"
shasum -a 256 "${FIXTURE}"
echo "-- sidecars before"
ls -l "${FIXTURE}-wal" "${FIXTURE}-shm"
echo "sidecar listing exit: $?"

echo "== pre bridge ready lock (three-valued)"
LOCK="${HOME}/Library/Containers/com.apple.MobileSMS/Data/.imsg-bridge-ready"
if [ -e "${LOCK}" ]; then
  echo "ready lock: PRESENT - this rung must not run here"
  exit 75
elif [ -r "${HOME}/Library/Containers/com.apple.MobileSMS/Data" ]; then
  echo "ready lock: absent (container readable)"
else
  echo "ready lock: UNREADABLE - not the same as absent, stopping"
  exit 76
fi

echo "== pre process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== pre crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== RUN"
date -u "+%Y-%m-%dT%H:%M:%SZ"
/usr/bin/env -i HOME="${RUNHOME}" PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${RUNTMP}" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 "${PRODUCT}" rpc --db "${FIXTURE}" <<'REQUEST'
{"jsonrpc":"2.0","id":"f2-1","method":"status","params":{}}
REQUEST
echo "product exit: $?"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== post fixture"
shasum -a 256 "${FIXTURE}"
echo "-- sidecars after"
ls -l "${FIXTURE}-wal" "${FIXTURE}-shm"
echo "sidecar listing exit: $?"

echo "== post process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== post crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== post bridge ready lock"
if [ -e "${LOCK}" ]; then
  echo "ready lock: PRESENT AFTER THE RUN - it was absent before"
else
  echo "ready lock: still absent"
fi

echo "== post TCC log"
log show --last 3m --predicate 'subsystem == "com.apple.TCC"' --style compact
echo "log exit: $?"

echo "== phase-f f2 end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
