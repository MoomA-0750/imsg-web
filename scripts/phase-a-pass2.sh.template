        file -bL "${product}"
        shasum -a 256 "${product}"
      else
        echo "absent"
      fi
    done
  else
    echo "absent"
  fi
fi

echo "== P5 ps end"
ps -axo pid,ppid,user,etime,comm

echo "== phase-a pass2 end"
