#!/bin/sh
# Step2 Phase B / pass 2 — per-artifact detail. Read-only.
#
# Generated by scripts/gen-phase-a.mjs, which substitutes the base path, the
# build-tree root and the role, and refuses unsafe characters.
#
# Same contract as pass 1: no imsg, no node execution, no sudo, no writes, no
# signals, no launchctl or serve mutation, no discarded stderr, every path
# bounded. Two deliberate additions over pass 1, both read-only:
#
#   * `swift --version` — a Swift 6.0 toolchain is required to build 0.15.4 and
#     neither host's version was ever recorded. Guarded on the shim existing,
#     since pass 1 confirmed Command Line Tools are present on both.
#   * `git` — restricted by the generator to the non-locking read-only forms.
#     Plain `git status` writes .git/index and can spawn a resident fsmonitor
#     daemon, so every invocation below carries --no-optional-locks and disables
#     fsmonitor and the untracked cache per-invocation.
#
# Never read here: the owner state files. Their existence, mode and size are
# recorded; their contents are not read and not hashed.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

BASE='@@BASE@@'
TMPD='@@TMPD@@'
ROLE='@@ROLE@@'

echo "== phase-a pass2 begin"
echo "role: ${ROLE}"

# ---------------------------------------------------------------- P0 context
echo "== P0 ps start"
# Taken at both ends of THIS session. Pass 1's capture was a different session
# on a different day and cannot be diffed against anything here.
ps -axo pid,ppid,user,etime,comm

echo "== P0 toolchain"
if [ -x /usr/bin/swift ]; then
  # stdin is the rest of this script; keep every tool away from it.
  /usr/bin/swift --version < /dev/null
  echo "swift --version exit: $?"
else
  echo "no /usr/bin/swift"
fi
xcode-select -p
echo "xcode-select exit: $?"

echo "== P0 disk"
df -k "${BASE}"
echo "df base exit: $?"
df -k /private/tmp
echo "df tmp exit: $?"

# ------------------------------------------------------------- P1 node image
echo "== P1 dedicated node"
if [ "${ROLE}" = 'intel' ]; then
  NODEBIN="${BASE}/runtime/node-v24.20.0-darwin-x64/bin/node"
else
  NODEBIN="${BASE}/runtime/node-v24.20.0-darwin-arm64/bin/node"
fi
echo "-- ${NODEBIN}"
if [ -f "${NODEBIN}" ]; then
  # Not executed. Identity comes from the digest, which is compared against the
  # official archive member computed on the workstation.
  shasum -a 256 "${NODEBIN}"
  stat -L -f "%Sp %Su:%Sg %z %Sm %N" "${NODEBIN}"
  file -bL "${NODEBIN}"
  xattr -l "${NODEBIN}"
  lipo -archs "${NODEBIN}"
  echo "lipo exit: $?"
  codesign -dvvv "${NODEBIN}" 2>&1
  echo "codesign exit: $?"
  otool -L "${NODEBIN}"
  echo "otool exit: $?"
else
  echo "absent"
fi

# ------------------------------------------------------------- P2 stock imsg
echo "== P2 stock imsg libexec"
if [ "${ROLE}" = 'intel' ]; then
  IMSGBIN='/usr/local/Cellar/imsg/0.14.2/libexec/imsg'
else
  IMSGBIN='/opt/homebrew/Cellar/imsg/0.15.3/libexec/imsg'
fi
echo "-- ${IMSGBIN}"
if [ -f "${IMSGBIN}" ]; then
  # Production will run a build of ours, so this image is recorded for the
  # record rather than bound. It is what the owner runs by hand.
  codesign -dvvv "${IMSGBIN}" 2>&1
  echo "codesign exit: $?"
  codesign -d --entitlements :- "${IMSGBIN}" 2>&1
  echo "entitlements exit: $?"
  otool -L "${IMSGBIN}"
  echo "otool exit: $?"
else
  echo "absent"
fi

# --------------------------------------------------------- P3 base artifacts
echo "== P3 project plists"
find "${BASE}" -maxdepth 1 -type f -name '*.plist' -print
echo "find plist exit: $?"
find "${BASE}" -maxdepth 1 -type f -name '*.plist' -exec shasum -a 256 {} +
echo "shasum plist exit: $?"
find "${BASE}" -maxdepth 1 -type f -name '*.plist' -exec cat {} +
echo "cat plist exit: $?"

echo "== P3 owner state (metadata only, never read)"
find "${BASE}" -maxdepth 2 -type f -name 'owner.json' -exec stat -f "%Sp %Su:%Sg %z %N" {} +
echo "stat owner exit: $?"

echo "== P3 release 9b64d36-p0c1"
if [ -d "${BASE}/releases/9b64d36-p0c1" ]; then
  find "${BASE}/releases/9b64d36-p0c1" -maxdepth 6 -type f -print | wc -l
  echo "file count exit: $?"
  find "${BASE}/releases/9b64d36-p0c1" -maxdepth 6 -type f -name '*.tar*' -exec shasum -a 256 {} +
  echo "archive shasum exit: $?"
  du -sk "${BASE}/releases/9b64d36-p0c1"
  echo "du exit: $?"
else
  echo "absent"
fi

echo "== P3 release a342425"
if [ -d "${BASE}/releases/a342425" ]; then
  find "${BASE}/releases/a342425" -maxdepth 6 -type f -print | wc -l
  echo "file count exit: $?"
  find "${BASE}/releases/a342425" -maxdepth 6 -type f -name '*.tar*' -exec shasum -a 256 {} +
  echo "archive shasum exit: $?"
  du -sk "${BASE}/releases/a342425"
  echo "du exit: $?"
else
  echo "absent"
fi

# ---------------------------------------------------------- P4 build trees
echo "== P4 build trees"
if [ "${TMPD}" = 'NONE' ]; then
  echo "no build-tree root for this host"
else
  echo "-- tree baseline"
  if [ -d "${TMPD}/baseline" ]; then
    shasum -a 256 "${TMPD}/baseline/Package.swift"
    echo "Package.swift shasum exit: $?"
    shasum -a 256 "${TMPD}/baseline/Package.resolved"
    echo "Package.resolved shasum exit: $?"
    # Content, not just the digest: the transitive choices this lock made were
    # never reviewed, only hashed. It is a small JSON of dependency URLs,
    # revisions and versions and carries nothing private.
    cat "${TMPD}/baseline/Package.resolved"
    echo "Package.resolved cat exit: $?"

    # Resolve the real git directory first. A linked worktree keeps its index
    # lock under the main repository, so checking <tree>/.git/index.lock would
    # always report "absent" and prove nothing.
    GITDIR="$(git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/baseline" rev-parse --absolute-git-dir)"
    echo "git-dir exit: $?"
    echo "git-dir: ${GITDIR}"
    # The plan aborts a tree whose index is already locked. A linked worktree
    # keeps that lock under the main repository, so the resolved git dir is
    # what must be checked -- not <tree>/.git/index.lock, which for a worktree
    # is always absent and proves nothing.
    if [ -e "${GITDIR}/index.lock" ]; then
      echo "index.lock PRESENT - this tree aborts"
    else
      echo "index.lock absent"
    fi
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/baseline" rev-parse HEAD
    echo "rev-parse HEAD exit: $?"
    # Content-addressed, so it binds regardless of how commits were arranged.
    # The candidate trees carry the patch as commits, so HEAD is deliberately
    # not expected to equal the pinned commit.
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/baseline" rev-parse "HEAD^{tree}"
    echo "rev-parse tree exit: $?"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/baseline" status --porcelain
    echo "status exit: $?"

    du -sk "${TMPD}/baseline"
    echo "du tree exit: $?"
    find "${TMPD}/baseline" -maxdepth 1 -type d -name '.build' -print
    echo "find build exit: $?"
    du -sk "${TMPD}/baseline/.build"
    echo "du build exit: $?"
    # Named product paths only. Hashing everything under .build would be
    # thousands of files, and `find -print` also lists sockets and FIFOs, where
    # shasum would block forever and take the session with it.
    for product in "${TMPD}/baseline/.build/release/imsg" "${TMPD}/baseline/.build/debug/imsg"; do
      echo "-- product ${product}"
      if [ -f "${product}" ]; then
        stat -L -f "%Sp %Su:%Sg %z %Sm %N" "${product}"
        file -bL "${product}"
        shasum -a 256 "${product}"
      else
        echo "absent"
      fi
    done
  else
    echo "absent"
  fi

  echo "-- tree candidate"
  if [ -d "${TMPD}/candidate" ]; then
    shasum -a 256 "${TMPD}/candidate/Package.swift"
    echo "Package.swift shasum exit: $?"
    shasum -a 256 "${TMPD}/candidate/Package.resolved"
