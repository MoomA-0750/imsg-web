    if [ -e "${GITDIR}/index.lock" ]; then
      echo "index.lock PRESENT - this tree aborts"
    else
      echo "index.lock absent"
    fi
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate" rev-parse HEAD
    echo "rev-parse HEAD exit: $?"
    # Content-addressed, so it binds regardless of how commits were arranged.
    # The candidate trees carry the patch as commits, so HEAD is deliberately
    # not expected to equal the pinned commit.
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate" rev-parse "HEAD^{tree}"
    echo "rev-parse tree exit: $?"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate" status --porcelain
    echo "status exit: $?"

    du -sk "${TMPD}/candidate"
    echo "du tree exit: $?"
    find "${TMPD}/candidate" -maxdepth 1 -type d -name '.build' -print
    echo "find build exit: $?"
    du -sk "${TMPD}/candidate/.build"
    echo "du build exit: $?"
    # Named product paths only. Hashing everything under .build would be
    # thousands of files, and `find -print` also lists sockets and FIFOs, where
    # shasum would block forever and take the session with it.
    for product in "${TMPD}/candidate/.build/release/imsg" "${TMPD}/candidate/.build/debug/imsg"; do
      echo "-- product ${product}"
      if [ -f "${product}" ]; then
        stat -L -f "%Sp %Su:%Sg %z %Sm %N" "${product}"
        file -bL "${product}"
        shasum -a 256 "${product}"
      else
        echo "absent"
      fi
    done
  else
    echo "absent"
  fi

  echo "-- tree candidate-r3"
  if [ -d "${TMPD}/candidate-r3" ]; then
    shasum -a 256 "${TMPD}/candidate-r3/Package.swift"
    echo "Package.swift shasum exit: $?"
    shasum -a 256 "${TMPD}/candidate-r3/Package.resolved"
    echo "Package.resolved shasum exit: $?"
    # Content, not just the digest: the transitive choices this lock made were
    # never reviewed, only hashed. It is a small JSON of dependency URLs,
    # revisions and versions and carries nothing private.
    cat "${TMPD}/candidate-r3/Package.resolved"
    echo "Package.resolved cat exit: $?"

    # Resolve the real git directory first. A linked worktree keeps its index
    # lock under the main repository, so checking <tree>/.git/index.lock would
    # always report "absent" and prove nothing.
    GITDIR="$(git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate-r3" rev-parse --absolute-git-dir)"
    echo "git-dir exit: $?"
    echo "git-dir: ${GITDIR}"
    # The plan aborts a tree whose index is already locked. A linked worktree
    # keeps that lock under the main repository, so the resolved git dir is
    # what must be checked -- not <tree>/.git/index.lock, which for a worktree
    # is always absent and proves nothing.
    if [ -e "${GITDIR}/index.lock" ]; then
      echo "index.lock PRESENT - this tree aborts"
    else
      echo "index.lock absent"
    fi
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate-r3" rev-parse HEAD
    echo "rev-parse HEAD exit: $?"
