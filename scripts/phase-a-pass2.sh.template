    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate-r3" rev-parse "HEAD^{tree}"
    echo "rev-parse tree exit: $?"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate-r3" status --porcelain
    echo "status exit: $?"

    du -sk "${TMPD}/candidate-r3"
    echo "du tree exit: $?"
    find "${TMPD}/candidate-r3" -maxdepth 1 -type d -name '.build' -print
    echo "find build exit: $?"
    du -sk "${TMPD}/candidate-r3/.build"
    echo "du build exit: $?"
    # Named product paths only. Hashing everything under .build would be
    # thousands of files, and `find -print` also lists sockets and FIFOs, where
    # shasum would block forever and take the session with it.
    for product in "${TMPD}/candidate-r3/.build/release/imsg" "${TMPD}/candidate-r3/.build/debug/imsg"; do
