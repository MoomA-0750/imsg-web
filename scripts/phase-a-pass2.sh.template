    GITDIR="$(git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${TMPD}/candidate" rev-parse --absolute-git-dir)"
    echo "git-dir exit: $?"
    echo "git-dir: ${GITDIR}"
    # The plan aborts a tree whose index is already locked. A linked worktree
