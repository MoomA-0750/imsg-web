#!/bin/sh
# Phase F / F3 — the same run, terminated by SIGTERM instead of stdin EOF.
#
# Separate from F2 because EOF and SIGTERM are different paths in the server,
# and the production Agent's shutdown uses the latter. The pinned source has no
# SIGTERM handler anywhere in Sources, so the predicted outcome is default
# disposition and status 143; anything else is a finding.
#
# `kill` is forbidden by every other generator in this project. Here it is
# permitted in exactly one shape — `kill -TERM "${CHILD}"`, where CHILD is the
# PID this script itself started. It can signal nothing it did not create.
#
# stdin is held open by a `sleep` in a pipeline rather than a here-document:
# a here-document reaches EOF immediately, and the server would exit down the
# EOF path before there was anything to signal. The pipeline also keeps stdin
# non-TTY, which is what stops `ContactResolver` reaching `requestAccess`.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

PRODUCT='@@PRODUCT@@'
RUNHOME='@@RUNHOME@@'
RUNTMP='@@RUNTMP@@'
RUNCWD='@@RUNCWD@@'
FIXTURE='@@FIXTURE@@'
ROLE='@@ROLE@@'

echo "== phase-f f3 begin"
echo "role: ${ROLE}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== pre bridge ready lock (three-valued)"
LOCK="${HOME}/Library/Containers/com.apple.MobileSMS/Data/.imsg-bridge-ready"
if [ -e "${LOCK}" ]; then
  echo "ready lock: PRESENT - this rung must not run here"
  exit 75
elif [ -r "${HOME}/Library/Containers/com.apple.MobileSMS/Data" ]; then
  echo "ready lock: absent (container readable)"
else
  echo "ready lock: UNREADABLE - not the same as absent, stopping"
  exit 76
fi

echo "== pre fixture"
shasum -a 256 "${FIXTURE}"

echo "== pre process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== pre crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== RUN"
date -u "+%Y-%m-%dT%H:%M:%SZ"
sleep 8 | /usr/bin/env -i HOME="${RUNHOME}" PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${RUNTMP}" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 "${PRODUCT}" rpc --db "${FIXTURE}" &
CHILD=$!
echo "started pid: ${CHILD}"
sleep 3

echo "-- alive before the signal?"
ps -p "${CHILD}" -o pid=,ppid=,etime=,comm=
echo "ps exit: $?"

echo "-- sending SIGTERM to the process this script started"
kill -TERM "${CHILD}"
echo "kill exit: $?"
wait "${CHILD}"
echo "product exit after SIGTERM: $?"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "-- alive after the signal?"
ps -p "${CHILD}" -o pid=,ppid=,etime=,comm=
echo "ps exit (1 means gone): $?"

echo "== post fixture"
shasum -a 256 "${FIXTURE}"
ls -l "${FIXTURE}-wal" "${FIXTURE}-shm"
echo "sidecar listing exit: $?"

echo "== post process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== post crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== post bridge ready lock"
if [ -e "${LOCK}" ]; then
  echo "ready lock: PRESENT AFTER THE RUN - it was absent before"
else
  echo "ready lock: still absent"
fi

echo "== post TCC log"
log show --last 3m --predicate 'subsystem == "com.apple.TCC"' --style compact
echo "log exit: $?"

echo "== phase-f f3 end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
