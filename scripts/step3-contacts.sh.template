#!/bin/sh
# Step3 rung H1 — does --contacts-from-address-book actually reach the
# AddressBook reader, and is that store readable by this binary?
#
# Generated by scripts/gen-step3.mjs. Run twice, once per arm:
#
#   --contacts-source auto         control. No flag. Expected: available=false,
#                                  because isSSH is false under `env -i` and a
#                                  self-built binary is .notDetermined.
#   --contacts-source addressbook  the flag. Expected: available=true IF the
#                                  store is readable by this process.
#
# Without the control arm a `false` cannot be told apart from a flag that does
# nothing, so both arms are required and neither is interpreted alone.
#
# WHAT THIS RUNG READS
#
# `status` returns only `contacts.available`, a boolean. But reaching that
# boolean calls ContactCatalog.snapshot(), which on a readable source loads the
# WHOLE address book into the process -- every name, phone number and email.
# Nothing of it is emitted and nothing is written, but the owner's contacts are
# read. That is authorized for this rung specifically and is not a precedent.
#
# Since NSHomeDirectory() ignores $HOME (established in rung G0), the
# AddressBook directory this resolves to is the REAL one. `env -i HOME=...`
# does not move it and is not pretending to.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

PRODUCT='@@PRODUCT@@'
RUNHOME='@@RUNHOME@@'
RUNTMP='@@RUNTMP@@'
RUNCWD='@@RUNCWD@@'
FIXTURE='@@FIXTURE@@'
ROLE='@@ROLE@@'
SOURCE_LABEL='@@SOURCE_LABEL@@'

echo "== step3 contacts begin"
echo "role: ${ROLE}  arm: ${SOURCE_LABEL}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== product identity"
shasum -a 256 "${PRODUCT}"

echo "== fixture before"
shasum -a 256 "${FIXTURE}"

# Three-valued, like every readability check in this project: readable,
# unreadable, absent. "Unreadable" is never recorded as "absent".
echo "== address book store readability (three-valued)"
AB="${HOME}/Library/Application Support/AddressBook"
if [ ! -e "${AB}" ]; then
  echo "address book: ABSENT at the expected path"
elif [ -r "${AB}" ]; then
  echo "address book: readable"
  # Directory entries only. Names of files, never their contents.
  ls -1 "${AB}"
  echo "ls exit: $?"
  ls -1 "${AB}/Sources"
  echo "ls sources exit: $?"
else
  echo "address book: UNREADABLE - not the same as absent"
fi

echo "== pre process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== RUN"
date -u "+%Y-%m-%dT%H:%M:%SZ"
/usr/bin/env -i HOME="${RUNHOME}" PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${RUNTMP}" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 "${PRODUCT}" rpc --db "${FIXTURE}"@@CONTACTS_FLAG@@ <<'REQUEST'
{"jsonrpc":"2.0","id":"h1-1","method":"status","params":{}}
REQUEST
echo "product exit: $?"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== fixture after"
shasum -a 256 "${FIXTURE}"

echo "== address book after - unchanged is required, this is a read"
ls -1 "${AB}"
echo "ls exit: $?"

echo "== post process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== post crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== post TCC log"
log show --last 3m --predicate 'subsystem == "com.apple.TCC"' --style compact
echo "log exit: $?"

echo "== step3 contacts end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
