#!/bin/sh
# Step2 Phase D — build baseline and candidate under observation.
#
# Generated by scripts/gen-phase-d.mjs. This is NOT produced by the read-only
# probe generator: that generator's refusal of every write IS the guarantee for
# Phases A, B and C8, and relaxing it would weaken every probe it has made.
#
# Contract, enforced by the Phase D generator:
#   - every write goes under the build root
#   - no rm, no sudo, no launchctl, no tailscale, no brew, no kill
#   - imsg and node are never executed; the build's PRODUCTS are never executed
#   - stock imsg, the dedicated Node runtimes, existing build trees and retained
#     releases are not touched, not reused and not deleted
#
# Five package manifests ARE compiled and executed by SwiftPM, under its own
# sandbox. --disable-sandbox is never passed. No dependency declares a plugin;
# that was verified on the workstation before this ran.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

ROOT='@@BUILDROOT@@'
ROLE='@@ROLE@@'
ARCHIVE='@@ARCHIVE@@'
ARCHIVE_SHA='@@ARCHIVE_SHA@@'

# SwiftPM writes to ~/Library/Caches/org.swift.swiftpm, ~/.swiftpm and
# ~/Library/org.swift.swiftpm/security by default. Every one is redirected under
# the root, and the sweep at the end checks whether anything landed outside
# anyway -- confinement is observed, not asserted.
SWIFTPM="--cache-path ${ROOT}/swiftpm-cache --config-path ${ROOT}/swiftpm-config --security-path ${ROOT}/swiftpm-security"
TMPDIR="${ROOT}/tmp"
export TMPDIR

echo "== phase-d build begin"
echo "role: ${ROLE}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== D0 toolchain"
/usr/bin/swift --version < /dev/null
echo "swift --version exit: $?"
xcode-select -p
xcrun --show-sdk-version < /dev/null
echo "sdk exit: $?"
sw_vers
uname -m

echo "== D0 root"
mkdir -p "${ROOT}/tmp"
echo "mkdir exit: $?"
stat -f "%Sp %Su:%Sg %N" "${ROOT}"
# Every default SwiftPM location is compared against this marker at the end.
touch "${ROOT}/.phase-d-marker"
echo "marker exit: $?"
df -k "${ROOT}"

echo "== D1 archive"
echo "expected: ${ARCHIVE_SHA}"
shasum -a 256 "${ARCHIVE}"
echo "shasum exit: $?"
ACTUAL_SHA="$(shasum -a 256 "${ARCHIVE}" | cut -d' ' -f1)"
if [ "${ACTUAL_SHA}" = "${ARCHIVE_SHA}" ]; then
  echo "archive digest MATCHES"
else
  echo "archive digest MISMATCH - stopping"
  exit 70
fi
tar -xzf "${ARCHIVE}" -C "${ROOT}"
echo "tar exit: $?"
find "${ROOT}" -maxdepth 1 -type d -print

# ---------------------------------------------------------------- per arm
build_arm() {
  arm="$1"
  dir="${ROOT}/${arm}"
  echo "== ARM ${arm}"
  if [ ! -d "${dir}" ]; then
    echo "absent - stopping this arm"
    return 0
  fi

  echo "-- ${arm} toolchain at build time"
  /usr/bin/swift --version < /dev/null

  echo "-- ${arm} lock before resolve"
  shasum -a 256 "${dir}/Package.resolved"

  echo "-- ${arm} resolve"
  # Resolve first so patch-deps has checkouts to patch, exactly as upstream's
  # Makefile does. Recorded separately from the build, because this is the step
  # that can rewrite the lock.
  cd "${dir}" && /usr/bin/swift package ${SWIFTPM} --scratch-path "${dir}/.build" resolve < /dev/null
  echo "resolve exit: $?"

  echo "-- ${arm} lock after resolve"
  shasum -a 256 "${dir}/Package.resolved"

  echo "-- ${arm} checkouts before patch"
  for dep in SQLite.swift PhoneNumberKit Commander CSQLite; do
    echo "--- ${dep}"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" rev-parse HEAD
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" rev-parse "HEAD^{tree}"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" status --porcelain
  done

  echo "-- ${arm} patch-deps"
  # Upstream's own script, run because building without it produces something
  # upstream never ships: PhoneNumberKit gates its bundle search on DEBUG, and
  # a release build falls through to Bundle.module, which fatalErrors when the
  # bundle is not found. 68 lines, fail-closed, writes only under .build/checkouts.
  cd "${dir}" && ./scripts/patch-deps.sh
  echo "patch-deps exit: $?"

  echo "-- ${arm} checkouts after patch"
  for dep in SQLite.swift PhoneNumberKit Commander CSQLite; do
    echo "--- ${dep}"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" rev-parse "HEAD^{tree}"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" status --porcelain
  done

  echo "-- ${arm} build"
  # --force-resolved-versions makes a needed resolution an error instead of a
  # silent lock rewrite. The historical comparisons used this and skip-update;
  # an earlier draft of this plan claimed to match them and did not.
  date -u "+%Y-%m-%dT%H:%M:%SZ"
  cd "${dir}" && /usr/bin/swift build ${SWIFTPM} --scratch-path "${dir}/.build" -c release --product imsg --force-resolved-versions -j 2 < /dev/null
  echo "build exit: $?"
  date -u "+%Y-%m-%dT%H:%M:%SZ"

  echo "-- ${arm} lock after build"
  shasum -a 256 "${dir}/Package.resolved"

  echo "-- ${arm} product"
  # .build/release is a symlink to .build/<triple>/release, and safeTree rejects
  # a symlink in any path component, so the resolved path is what matters.
  stat -f "%N -> %Y" "${dir}/.build/release"
  PRODUCT="${dir}/.build/release/imsg"
  if [ -f "${PRODUCT}" ]; then
    stat -L -f "%Sp %Su:%Sg %z %Sm %N" "${PRODUCT}"
    file -bL "${PRODUCT}"
    lipo -archs "${PRODUCT}"
    shasum -a 256 "${PRODUCT}"
    codesign -dvvv "${PRODUCT}" 2>&1
    echo "codesign exit: $?"
    otool -L "${PRODUCT}"
    otool -l "${PRODUCT}" | grep -A4 LC_BUILD_VERSION
  else
    echo "product absent"
  fi

  echo "-- ${arm} resource bundles"
  # The product is not one file. PhoneNumberKit ships its metadata as a bundle
  # beside the executable, and Bundle.module fatalErrors if it is missing.
  find "${dir}/.build/release/" -maxdepth 1 -name '*.bundle' -print
  echo "find bundle exit: $?"
  find "${dir}/.build/release/" -maxdepth 3 -type f -path '*.bundle/*' -exec shasum -a 256 {} +
  echo "bundle manifest exit: $?"
}

build_arm baseline
build_arm candidate

# ------------------------------------------------------------ confinement
echo "== D5 confinement sweep"
# Names only, and only what is newer than the marker. A non-empty result means
# the build wrote outside the root despite every path flag, which is a finding.
for outside in "${HOME}/.swiftpm" "${HOME}/Library/Caches/org.swift.swiftpm" "${HOME}/Library/org.swift.swiftpm" "${HOME}/Library/Application Support/org.swift.swiftpm"; do
  echo "-- ${outside}"
  if [ -e "${outside}" ]; then
    find "${outside}" -maxdepth 3 -newer "${ROOT}/.phase-d-marker" -print
    echo "sweep exit: $?"
  else
    echo "absent"
  fi
done

echo "== phase-d build end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
