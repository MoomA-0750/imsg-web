#!/bin/sh
# Step2 Phase D — build baseline and candidate under observation.
#
# Generated by scripts/gen-phase-d.mjs. NOT produced by the read-only probe
# generator: that generator's refusal of every write IS the guarantee for
# Phases A, B and C8, and relaxing it would weaken every probe it has made.
#
# Contract, enforced by the Phase D generator:
#   - every write from THIS script names a path under the build root, but
#     "nothing outside the root is written" would be false: SwiftPM recreates
#     ~/.swiftpm/security on every run, and on one host that also relaxed the
#     link's mode. Observed by the sweep at the end rather than asserted here.
#   - no rm, no sudo, no launchctl, no tailscale, no brew, no kill
#   - no network TOOLS (curl/scp/ssh/nc). SwiftPM's dependency fetch is the one
#     approved network step: the revisions are pinned and git verifies every
#     object against its hash, so a tampered remote fails closed. Saying "no
#     network" here would have been false, and someone reading only this header
#     would have recorded it as fact.
#   - imsg and node are never executed; the build's PRODUCTS are never executed
#   - stock imsg, the dedicated Node runtimes, existing build trees and retained
#     releases are not touched, not reused and not deleted
#
# Five package manifests ARE compiled and executed by SwiftPM under its own
# sandbox; --disable-sandbox is never passed. No dependency declares a plugin,
# verified on the workstation beforehand.
#
# Every --cache-path/--config-path/--security-path/--scratch-path value is
# written inline and quoted. An earlier draft collected them into one variable
# and expanded it unquoted; the base path contains a space, so under POSIX sh
# that produced `--cache-path /Users/…/Library/Application` -- a write target
# OUTSIDE the build root, on the very first run.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

ROOT='@@BUILDROOT@@'
ROLE='@@ROLE@@'
ARCHIVE='@@ARCHIVE@@'
ARCHIVE_SHA='@@ARCHIVE_SHA@@'

TMPDIR="${ROOT}/tmp"
export TMPDIR

BASELINE_STATUS=skipped
CANDIDATE_STATUS=skipped

echo "== phase-d build begin"
echo "role: ${ROLE}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== D0 root"
# No -p, deliberately. -p succeeds on an existing root, which would reuse a
# previous run's .build and checkouts and make the "before patch" status show
# the previous patch; and -p creates missing parents, so a mistyped root would
# quietly create a chain of new directories. A re-run must use a new root name.
mkdir "${ROOT}"
MKDIR_EXIT=$?
echo "mkdir root exit: ${MKDIR_EXIT}"
if [ "${MKDIR_EXIT}" -ne 0 ]; then
  echo "root exists or its parent is missing - stopping"
  exit 71
fi
mkdir "${ROOT}/tmp"
echo "mkdir tmp exit: $?"
# Placed before any other command so even the first toolchain query is inside
# the window the confinement sweep examines.
touch "${ROOT}/.phase-d-marker"
echo "marker exit: $?"
stat -f "%Sp %Su:%Sg %N" "${ROOT}"
df -k "${ROOT}"

echo "== D0 toolchain"
/usr/bin/swift --version < /dev/null
echo "swift --version exit: $?"
xcode-select -p
xcrun --show-sdk-version < /dev/null
xcrun --show-sdk-build-version < /dev/null
echo "sdk exit: $?"
sw_vers
uname -m

echo "== D1 archive"
echo "expected: ${ARCHIVE_SHA}"
shasum -a 256 "${ARCHIVE}"
ACTUAL_SHA=$(shasum -a 256 "${ARCHIVE}" | cut -d' ' -f1)
if [ "${ACTUAL_SHA}" != "${ARCHIVE_SHA}" ]; then
  echo "archive digest MISMATCH - stopping"
  exit 70
fi
echo "archive digest MATCHES"
tar -xzf "${ARCHIVE}" -C "${ROOT}"
TAR_EXIT=$?
echo "tar exit: ${TAR_EXIT}"
if [ "${TAR_EXIT}" -ne 0 ]; then
  echo "extraction failed - stopping"
  exit 72
fi
find "${ROOT}" -maxdepth 1 -type d -print

echo "== D1 extracted inventory"
# The archive carries no .git, so a tree hash cannot be recomputed here. A
# per-file manifest of the tracked tree is the comparable thing, and it is
# checked against the workstation rather than merely recorded.
find "${ROOT}/baseline" -maxdepth 8 -type f -exec shasum -a 256 {} +
echo "baseline manifest exit: $?"
find "${ROOT}/candidate" -maxdepth 8 -type f -exec shasum -a 256 {} +
echo "candidate manifest exit: $?"

# ---------------------------------------------------------------- per arm
build_arm() {
  arm="$1"
  dir="${ROOT}/${arm}"
  echo "== ARM ${arm}"
  ARM_STATUS=skipped
  if [ ! -d "${dir}" ]; then
    echo "absent - stopping this arm"
    return 0
  fi

  echo "-- ${arm} toolchain at build time"
  /usr/bin/swift --version < /dev/null

  echo "-- ${arm} patch-deps present and executable"
  if [ ! -x "${dir}/scripts/patch-deps.sh" ]; then
    echo "patch-deps.sh missing or not executable - stopping this arm"
    ARM_STATUS=no-patch-deps
    return 0
  fi

  echo "-- ${arm} lock before resolve"
  shasum -a 256 "${dir}/Package.resolved"

  echo "-- ${arm} resolve"
  cd "${dir}"
  /usr/bin/swift package \
    --cache-path "${ROOT}/swiftpm-cache" \
    --config-path "${ROOT}/swiftpm-config" \
    --security-path "${ROOT}/swiftpm-security" \
    --scratch-path "${dir}/.build" \
    resolve < /dev/null
  RESOLVE_EXIT=$?
  echo "resolve exit: ${RESOLVE_EXIT}"
  if [ "${RESOLVE_EXIT}" -ne 0 ]; then
    echo "resolve failed - stopping this arm"
    ARM_STATUS=resolve-failed
    return 0
  fi

  echo "-- ${arm} lock after resolve"
  shasum -a 256 "${dir}/Package.resolved"

  echo "-- ${arm} pin set"
  # The lock digest can move for reasons other than a changed pin (originHash
  # is recomputed by some toolchains). What must not move is the set of pins.
  #
  # Both directions. The first version checked only that the four expected
  # revisions were still PRESENT, and it passed on a host whose older SwiftPM
  # ADDED a fifth (sqlcipher.swift, fetched as a prebuilt xcframework and not
  # linked into the product). Checking only for absence is the same shape of
  # error as a check that cannot fail.
  grep '"identity"' "${dir}/Package.resolved"
  PIN_COUNT=$(grep -c '"identity"' "${dir}/Package.resolved")
  echo "pin count: ${PIN_COUNT} (expected 4)"
  PINS_OK=1
  if [ "${PIN_COUNT}" -ne 4 ]; then
    echo "pin count differs - the resolved graph is not the committed one"
    PINS_OK=0
  fi
  for rev in bd219c4ee9032fee3e009856f81fcc6ec09a85f4 8ad83035460a3d1029a2c5a0cca4f980297a9ca2 15c27dbf811e96b9fe48525389ffe042adb9f8cb 964c300fb0736699ce945c9edb56ecd62eba27a3; do
    if grep -q "${rev}" "${dir}/Package.resolved"; then
      echo "pin present: ${rev}"
    else
      echo "pin MISSING: ${rev}"
      PINS_OK=0
    fi
  done
  if [ "${PINS_OK}" -ne 1 ]; then
    echo "resolution changed the pin set - stopping this arm"
    ARM_STATUS=pins-changed
    return 0
  fi

  echo "-- ${arm} patch targets before"
  # rev-parse HEAD^{tree} does NOT change when a working tree is edited, so it
  # cannot pin what patch-deps does. File digests can.
  shasum -a 256 "${dir}/.build/checkouts/PhoneNumberKit/Sources/PhoneNumberKit/Bundle+Resources.swift"
  shasum -a 256 "${dir}/.build/checkouts/SQLite.swift/Package.swift"
  for dep in SQLite.swift PhoneNumberKit Commander CSQLite; do
    echo "--- ${dep}"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" rev-parse HEAD
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" status --porcelain
  done

  echo "-- ${arm} patch-deps"
  cd "${dir}"
  ./scripts/patch-deps.sh
  PATCH_EXIT=$?
  echo "patch-deps exit: ${PATCH_EXIT}"
  if [ "${PATCH_EXIT}" -ne 0 ]; then
    echo "patch-deps failed - stopping this arm"
    ARM_STATUS=patch-failed
    return 0
  fi

  echo "-- ${arm} patch targets after"
  shasum -a 256 "${dir}/.build/checkouts/PhoneNumberKit/Sources/PhoneNumberKit/Bundle+Resources.swift"
  shasum -a 256 "${dir}/.build/checkouts/SQLite.swift/Package.swift"
  for dep in SQLite.swift PhoneNumberKit Commander CSQLite; do
    echo "--- ${dep}"
    git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false -C "${dir}/.build/checkouts/${dep}" status --porcelain
  done

  echo "-- ${arm} build"
  echo "command: /usr/bin/swift build --cache-path ${ROOT}/swiftpm-cache --config-path ${ROOT}/swiftpm-config --security-path ${ROOT}/swiftpm-security --scratch-path ${dir}/.build -c release --product imsg --force-resolved-versions -j 2"
  date -u "+%Y-%m-%dT%H:%M:%SZ"
  cd "${dir}"
  /usr/bin/swift build \
    --cache-path "${ROOT}/swiftpm-cache" \
    --config-path "${ROOT}/swiftpm-config" \
    --security-path "${ROOT}/swiftpm-security" \
    --scratch-path "${dir}/.build" \
    -c release --product imsg --force-resolved-versions -j 2 < /dev/null
  BUILD_EXIT=$?
  echo "build exit: ${BUILD_EXIT}"
  date -u "+%Y-%m-%dT%H:%M:%SZ"
  if [ "${BUILD_EXIT}" -ne 0 ]; then
    echo "build failed - stopping this arm"
    ARM_STATUS=build-failed
    return 0
  fi

  echo "-- ${arm} lock after build"
  shasum -a 256 "${dir}/Package.resolved"

  echo "-- ${arm} product"
  stat -f "%N -> %Y" "${dir}/.build/release"
  PRODUCT="${dir}/.build/release/imsg"
  if [ ! -f "${PRODUCT}" ]; then
    echo "product absent"
    ARM_STATUS=no-product
    return 0
  fi
  stat -L -f "%Sp %Su:%Sg %z %Sm %N" "${PRODUCT}"
  file -bL "${PRODUCT}"
  lipo -archs "${PRODUCT}"
  shasum -a 256 "${PRODUCT}"
  codesign -dvvv "${PRODUCT}" 2>&1
  echo "codesign exit: $?"
  otool -L "${PRODUCT}"
  otool -l "${PRODUCT}" | grep -A4 LC_BUILD_VERSION

  echo "-- ${arm} resource bundles"
  # The product is not one file. PhoneNumberKit ships its metadata as a bundle
  # beside the executable, and in a release build Bundle.module fatalErrors if
  # it is missing. Depth 6: the payload sits at Contents/Resources/<file>.
  find "${dir}/.build/release/" -maxdepth 1 -name '*.bundle' -print
  find "${dir}/.build/release/" -maxdepth 6 -type f -path '*.bundle/*' -exec shasum -a 256 {} +
  echo "bundle manifest exit: $?"

  ARM_STATUS=ok
  return 0
}

build_arm baseline
BASELINE_STATUS="${ARM_STATUS}"
build_arm candidate
CANDIDATE_STATUS="${ARM_STATUS}"

# ------------------------------------------------------------ confinement
echo "== D5 confinement sweep"
for outside in "${HOME}/.swiftpm" "${HOME}/Library/Caches/org.swift.swiftpm" "${HOME}/Library/org.swift.swiftpm" "${HOME}/Library/Application Support/org.swift.swiftpm"; do
  echo "-- ${outside}"
  if [ -e "${outside}" ]; then
    find "${outside}" -maxdepth 6 -newer "${ROOT}/.phase-d-marker" -print
    echo "sweep exit: $?"
  else
    echo "absent"
  fi
done

echo "== SUMMARY"
echo "baseline: ${BASELINE_STATUS}"
echo "candidate: ${CANDIDATE_STATUS}"
echo "== phase-d build end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
if [ "${BASELINE_STATUS}" = "ok" ] && [ "${CANDIDATE_STATUS}" = "ok" ]; then
  exit 0
fi
exit 73
