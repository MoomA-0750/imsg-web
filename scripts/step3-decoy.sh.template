#!/bin/sh
# Step3 rung G0 — does the product resolve the bridge container through $HOME?
#
# Generated by scripts/gen-step3.mjs. One question, one bit, one execution.
#
# WHY THIS RUNG EXISTS
#
# Intel's bridge ready lock is present and belongs to the dylib injected into a
# running Messages.app by a separate system of the owner's. F2 and F3 were
# therefore never run there, so on Intel this project has never observed the RPC
# server start, the database open, the bundle resolve, or the process exit.
#
# Whether Intel can be exercised at all turns on one undetermined fact. The lock
# is resolved through NSHomeDirectory() (MessagesLauncher.swift) while the
# default database path uses FileManager.homeDirectoryForCurrentUser
# (MessageStore.swift) -- two different APIs, and whether either honours $HOME
# is unknown.
#
#   - If $HOME is honoured, a run under `env -i HOME=<private>` looks for the
#     lock inside the private root, finds nothing, and performs no IPC. Intel's
#     F2/F3 would then be safe.
#   - If it is not, the product finds the real lock and does IPC with a 0.14.2
#     dylib inside a running Messages.app. That is what was refused.
#
# F2 on M1 could not tell these apart: the lock was absent from both the real
# home and the private root, so both hypotheses predicted what was seen.
#
# THE EXPERIMENT
#
# Put a decoy lock inside the private root and see whether the product notices.
# `bridgeSnapshot()` distinguishes the two outcomes by error string:
#
#   "The bridge is not started. Run imsg launch explicitly before using bridge
#    methods."                                   -> .unavailable
#        The private root was NOT consulted. $HOME is ignored. Intel stays shut.
#
#   "The existing bridge did not answer a non-launching status probe."
#                                                -> .probeFailed
#        The decoy WAS found. $HOME is honoured. Intel's F2/F3 become arguable.
#
# This runs on M1 only, which has no bridge and no foreign system, so there is
# nothing here to disturb. Only the lock file is created: a failed request write
# and a timed-out poll both end in .probeFailed, so the inbox directories are
# not needed and are not made.
#
# NOTHING REAL IS OPENED. The generator refuses to emit a script naming
# Library/Messages or the address book at all, so this rung cannot be edited
# into one that reads the owner's data without the refusal firing.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

PRODUCT='@@PRODUCT@@'
RUNHOME='@@RUNHOME@@'
RUNTMP='@@RUNTMP@@'
RUNCWD='@@RUNCWD@@'
FIXTURE='@@FIXTURE@@'
ROLE='@@ROLE@@'

DECOY="${RUNHOME}/Library/Containers/com.apple.MobileSMS/Data"

echo "== step3 decoy begin"
echo "role: ${ROLE}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

# The real container, three-valued. This rung must not run on a host where a
# real lock exists: "absent" and "unreadable" are not the same answer, and the
# Phase A `command -v` mistake was exactly this -- a probe whose failure mode
# was known having its negative result read as evidence.
echo "== real container lock (three-valued)"
REAL="${HOME}/Library/Containers/com.apple.MobileSMS/Data"
if [ -e "${REAL}/.imsg-bridge-ready" ]; then
  echo "real ready lock: PRESENT - this rung must not run here"
  exit 75
elif [ -r "${REAL}" ]; then
  echo "real ready lock: absent (container readable)"
else
  echo "real ready lock: UNREADABLE - not the same as absent, stopping"
  exit 76
fi

# Refuse to reuse a decoy from an earlier run. mkdir -p would silently accept
# whatever was already there, which is how a re-run stops being a fresh
# observation.
echo "== decoy staging"
if [ -e "${DECOY}" ]; then
  echo "decoy already exists - not reusing it, stopping"
  exit 71
fi
mkdir -p "${DECOY}"
echo "mkdir decoy exit: $?"
touch "${DECOY}/.imsg-bridge-ready"
echo "touch decoy lock exit: $?"
stat -f "%Sp %Su:%Sg %z %Sm %N" "${DECOY}/.imsg-bridge-ready"

echo "== pre fixture"
shasum -a 256 "${FIXTURE}"

echo "== pre process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== RUN"
date -u "+%Y-%m-%dT%H:%M:%SZ"
/usr/bin/env -i HOME="${RUNHOME}" PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${RUNTMP}" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 "${PRODUCT}" rpc --db "${FIXTURE}" <<'REQUEST'
{"jsonrpc":"2.0","id":"g0-1","method":"status","params":{}}
REQUEST
echo "product exit: $?"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== post decoy"
# If the product wrote an IPC request it would have tried to create this; it is
# listed, never read, because on another host such a directory could hold a
# foreign system's request bodies.
ls -la "${DECOY}"
echo "ls decoy exit: $?"
ls -la "${DECOY}/.imsg-rpc"
echo "ls decoy rpc dir exit (1 means it was never made): $?"

echo "== post fixture"
shasum -a 256 "${FIXTURE}"

echo "== post real container"
if [ -e "${REAL}/.imsg-bridge-ready" ]; then
  echo "real ready lock: PRESENT AFTER THE RUN - it was absent before"
else
  echo "real ready lock: still absent"
fi

echo "== post process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== post crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== post TCC log"
log show --last 3m --predicate 'subsystem == "com.apple.TCC"' --style compact
echo "log exit: $?"

echo "== step3 decoy end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
