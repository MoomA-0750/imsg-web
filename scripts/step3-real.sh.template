#!/bin/sh
# Step3 rung H3 — the first time this project opens the owner's chat.db.
#
# Generated by scripts/gen-step3.mjs --pass real. One `status`, then EOF.
#
# `status` returns readiness and nothing else: no chat, no message, no handle.
# It is the narrowest thing that can be asked of the real database, and it
# exists to separate two failures that would otherwise arrive together --
# "cannot open it" and "opens it but reads it wrongly". F2 showed how badly a
# conflated version reads: an error naming Full Disk Access that was really a
# WAL fixture built wrong.
#
# WHAT THIS RUNG MUST WATCH, because the real database is not a fixture:
#
#   * WAL. chat.db is journalled WAL and a read-only open FAILS without its
#     -shm sidecar. The sidecars are live while Messages runs, so whether
#     Messages is running is part of the measurement condition, not background
#     detail. It is recorded before and after.
#   * The sidecars move on their own. Messages writes continuously, so a
#     changed -wal size is EXPECTED and is not evidence that we wrote. What
#     would be evidence is a change to chat.db's own size or inode.
#   * The bridge. `status` performs IPC when the ready lock is present. This
#     rung refuses to run on a host where it is, which is why it is M1 only.
#
# No flag is passed: contacts stay out of this rung so that a failure has one
# candidate cause. Contacts against real data is a later rung.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

PRODUCT='@@PRODUCT@@'
RUNHOME='@@RUNHOME@@'
RUNTMP='@@RUNTMP@@'
RUNCWD='@@RUNCWD@@'
REALDB='@@REALDB@@'
ROLE='@@ROLE@@'

echo "== step3 real begin"
echo "role: ${ROLE}"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== product identity"
shasum -a 256 "${PRODUCT}"

echo "== bridge ready lock (three-valued)"
LOCK="${HOME}/Library/Containers/com.apple.MobileSMS/Data/.imsg-bridge-ready"
if [ -e "${LOCK}" ]; then
  echo "ready lock: PRESENT - status would do IPC here, stopping"
  exit 75
elif [ -r "${HOME}/Library/Containers/com.apple.MobileSMS/Data" ]; then
  echo "ready lock: absent (container readable)"
else
  echo "ready lock: UNREADABLE - not the same as absent, stopping"
  exit 76
fi

echo "== is Messages running? (decides whether the sidecars are live)"
ps -axo pid,comm | grep MobileSMS
echo "grep exit (1 means not running): $?"

echo "== database before"
# Size, inode and mtime. Never the contents, and never a digest: a digest of a
# database Messages is actively writing tells you nothing and takes minutes.
stat -f "%Sp %Su:%Sg size=%z inode=%i mtime=%Sm %N" "${REALDB}"
stat -f "size=%z mtime=%Sm %N" "${REALDB}-wal"
echo "wal stat exit: $?"
stat -f "size=%z mtime=%Sm %N" "${REALDB}-shm"
echo "shm stat exit: $?"

echo "== pre process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== RUN"
date -u "+%Y-%m-%dT%H:%M:%SZ"
/usr/bin/env -i HOME="${RUNHOME}" PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${RUNTMP}" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 "${PRODUCT}" rpc --db "${REALDB}" <<'REQUEST'
{"jsonrpc":"2.0","id":"h3-1","method":"status","params":{}}
REQUEST
echo "product exit: $?"
date -u "+%Y-%m-%dT%H:%M:%SZ"

echo "== database after"
stat -f "%Sp %Su:%Sg size=%z inode=%i mtime=%Sm %N" "${REALDB}"
stat -f "size=%z mtime=%Sm %N" "${REALDB}-wal"
echo "wal stat exit: $?"
stat -f "size=%z mtime=%Sm %N" "${REALDB}-shm"
echo "shm stat exit: $?"

echo "== post process snapshot"
ps -axo pid,ppid,user,etime,comm

echo "== post bridge ready lock"
if [ -e "${LOCK}" ]; then
  echo "ready lock: PRESENT AFTER THE RUN - it was absent before"
else
  echo "ready lock: still absent"
fi

echo "== post crash reports"
ls -1 "${HOME}/Library/Logs/DiagnosticReports"
echo "ls crash reports exit: $?"

echo "== step3 real end"
date -u "+%Y-%m-%dT%H:%M:%SZ"
