#!/bin/sh
# Step2 Phase C / C8 — does the launch context already carry variables that
# change how code is loaded or linked? Read-only.
#
# Reports variable NAMES only, and only those matching a dangerous pattern.
# Everything else is counted, never named and never read. A launchd domain
# dictionary can hold an owner credential, which is why Phase A filtered this
# same block out of its raw log; this probe exists to answer the narrow
# question without reopening that.
#
# The defence does not depend on this. The child environment is an allow-list,
# so whatever is in here no longer reaches imsg either way. This is for the
# record: whether the current context was already carrying something.
#
# Both domains are read and labelled. `launchctl setenv` run over SSH lands in
# user/<uid>, while an Agent with LimitLoadToSessionType=Aqua loads into
# gui/<uid>, so reporting one without saying which would be misleading.

set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

echo "== phase-c c8 begin"
id -u
echo "id exit: $?"

# Prints only the key of each entry inside the environment block, classified.
# Deliberately never references the value side of a line: the key is field 1,
# so the parser never needs to look past it.
probe() {
  awk '
    tolower($0) ~ /environment[ \t]*=[ \t]*\{/ { inblock = 1; next }
    inblock == 1 && $0 ~ /^[ \t]*\}[ \t]*$/ { inblock = 0; next }
    inblock == 1 && $1 ~ /^[A-Za-z_][A-Za-z0-9_]*$/ {
      name = $1
      dangerous = 0
      if (name ~ /^(NODE_|DYLD_|UV_|SQLITE_|IMSG_)/) dangerous = 1
      if (name == "NODE_ENV") dangerous = 0
      if (name == "CFFIXED_USER_HOME" || name == "OPENSSL_CONF") dangerous = 1
      if (name == "SSL_CERT_FILE" || name == "SSL_CERT_DIR") dangerous = 1
      if (name == "HOMEBREW_PREFIX") dangerous = 1
      if (name == "SSH_CONNECTION" || name == "SSH_CLIENT") dangerous = 1
      if (dangerous == 1) { print "MATCH " name; matched++ } else { withheld++ }
    }
    END { print "matched: " matched + 0; print "withheld (name not printed): " withheld + 0 }
  '
}

echo "== c8 domain gui"
launchctl print "gui/$(id -u)" | probe
echo "gui pipeline exit (awk): $?"

echo "== c8 domain user"
launchctl print "user/$(id -u)" | probe
echo "user pipeline exit (awk): $?"

echo "== phase-c c8 end"
