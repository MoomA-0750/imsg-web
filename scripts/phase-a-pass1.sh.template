#!/bin/sh
# Step2 Phase A, Pass 1 (discovery) — read-only Mac inventory.
#
# Generated from this template by scripts/gen-phase-a.mjs, which replaces the
# base-path and role markers with literal values and refuses unsafe characters.
# The generated file contains private absolute paths and must never be
# committed to this repository.
#
# Sent as:  ssh -o BatchMode=yes -o RequestTTY=no -o ForwardAgent=no \
#               -o ClearAllForwardings=yes <HOST> /bin/sh -s < <generated>
#
# Contract, enforced by review of this file:
#   - invokes neither imsg nor any node executable
#   - no sudo, no writes, no signals, no launchctl/serve mutation
#   - no 2>/dev/null anywhere: stderr is evidence
#   - every path bounded; no find /, no mdfind, no locate
#   - reads neither the Messages database nor the TCC database
#
# set -u catches an unsubstituted marker. set -e is deliberately NOT used:
# a failing probe must be recorded, not abort the inventory.

set -u

# sshd hands a non-interactive shell its own default PATH, and a login profile
# is not sourced. Declaring it here removes the remaining dependence on remote
# environment and matches the project's "direct absolute executables" rule.
# Note what this means for A4: Homebrew's prefix is NOT on this PATH, so
# `command -v imsg` is expected to fail and the absolute probes below are the
# real discovery mechanism, not a fallback.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

BASE='@@BASE@@'
ROLE='@@ROLE@@'

echo "== phase-a pass1 begin"
echo "role: ${ROLE}"

# ---------------------------------------------------------------- A1 context
echo "== A1 host context"
id -un
id -u
hostname -s
sw_vers
uname -m
uname -r

# The '+' form expands to the word when set and to nothing when unset. It can
# never expand to the variable's value. Do not change this to ':-'.
echo "SSH_CONNECTION present: ${SSH_CONNECTION+yes}"
echo "interpreter: $0"

echo "== A1 command line tools"
xcode-select -p
echo "xcode-select exit: $?"

echo "== A1 base directory guard"
if [ -d "${BASE}" ]; then
  echo "base-ok"
else
  echo "base-missing"
fi
stat -f "%Sp %Su:%Sg %N" "${BASE}"
echo "stat exit: $?"

# ------------------------------------------------------------ A3 first ps
# Captured before any other probe so Pass 2's closing capture can be diffed
# against it. A single instant of ps proves nothing on its own.
echo "== A3 ps start"
ps -axo pid,ppid,user,etime,comm

echo "== A3 launchctl list"
launchctl list
echo "launchctl list exit: $?"

echo "== A3 launchctl print gui"
# The domain dump carries an `environment = { ... }` block. If the owner ever
# set a value there with `launchctl setenv` -- plausibly a key for the watcher's
# AI-reply branch -- it would be written verbatim into the raw log. AGENTS.md
# forbids logging owner keys, so the block is dropped before it is ever written.
# What this section is for is the loaded-service list, not the environment.
launchctl print "gui/$(id -u)" | awk '
  tolower($0) ~ /environment[ \t]*=[ \t]*\{/ { skipping = 1; print "  [environment block withheld]"; next }
  skipping == 1 { if ($0 ~ /^[ \t]*\}[ \t]*$/) { skipping = 0 } next }
  { print }
'
echo "launchctl print pipeline exit (awk): $?"

echo "== A3 launch agents on disk"
ls -la "${HOME}/Library/LaunchAgents"
echo "ls LaunchAgents exit: $?"

echo "== A3 tailscale resolution"
TS=''
if command -v tailscale; then
  TS="$(command -v tailscale)"
elif [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
  TS='/Applications/Tailscale.app/Contents/MacOS/Tailscale'
  echo "${TS}"
else
  echo "tailscale cli not found"
fi

echo "== A3 tailscale serve status"
if [ -n "${TS}" ]; then
  # Query only. Expected result is the recorded empty configuration; anything
  # else stops Phase A and is reported to the owner.
  "${TS}" serve status
  echo "serve status exit: $?"
else
  echo "skipped: no tailscale cli"
fi

if [ "${ROLE}" = 'intel' ]; then
  echo "== A3 watcher observation (bounded fields)"
  # pid, ppid, interpreter, script path -- and nothing more. The full argv is
  # never captured: the running watcher has an AI-reply branch and its argv or
  # environment may carry credentials. comm alone cannot identify a Python
  # script, since comm is the interpreter.
  ps -axo pid=,ppid=,args= | awk '/watcher\.py/ { print $1, $2, $3, $4 }'
  # This is the awk exit status, not ps's: a pipeline reports its last element.
  # A ps failure would show as empty output plus its own stderr, not as a
  # non-zero code here.
  echo "watcher pipeline exit (awk): $?"
fi

# ------------------------------------------------------------------ A2 tree
echo "== A2 base listing"
ls -la "${BASE}"
echo "ls exit: $?"

echo "== A2 base acl"
ls -le "${BASE}"
echo "ls -le exit: $?"

echo "== A2 tree"
find "${BASE}" -maxdepth 4 -print
echo "find tree exit: $?"

echo "== A2 symlinks"
# Enumerated once here. A link whose target resolves outside BASE/TMPD is
# recorded with its target and its target is NOT hashed in Pass 2. The only
# deliberate exception is the Homebrew bin entry handled in A4.
find "${BASE}" -maxdepth 4 -type l -exec ls -l {} +
echo "find symlinks exit: $?"

echo "== A2 executables"
# -perm -100 rather than -u+x: no ambiguity in BSD find symbolic modes.
find "${BASE}" -maxdepth 4 -type f -perm -100 -print
echo "find exec exit: $?"

echo "== A2 dylibs"
find "${BASE}" -maxdepth 4 -type f -name '*.dylib' -print
echo "find dylib exit: $?"

echo "== A2 plists"
# find, not a glob: zsh nomatch would abort a whole ls command on no match.
find "${BASE}" -maxdepth 1 -name '*.plist' -print
echo "find plist exit: $?"

echo "== A2 node candidates"
find "${BASE}" -maxdepth 4 -name 'node' -type f -print
echo "find node exit: $?"

echo "== A2 node archives"
find "${BASE}" -maxdepth 2 -type f -name 'node-v*' -print
echo "find node archive exit: $?"

echo "== A2 releases"
find "${BASE}" -maxdepth 1 -type d -name releases -print
echo "find releases dir exit: $?"
find "${BASE}/releases" -mindepth 1 -maxdepth 1 -type d -print
echo "find release entries exit: $?"

# ------------------------------------------------------- A4 imsg resolution
echo "== A4 imsg path"
# command -v is recorded for completeness but is NOT expected to find anything:
# the PATH declared at the top of this script deliberately excludes Homebrew's
# prefix. Discovery is done by probing absolute paths, so a miss here is a fact
# about PATH, never evidence that imsg is absent.
IMSG_ON_PATH="$(command -v imsg)"
echo "command -v exit: $?"
echo "command -v result: ${IMSG_ON_PATH}"

echo "== A4 absolute probes"
for candidate in /usr/local/bin/imsg /opt/homebrew/bin/imsg; do
  echo "-- probe: ${candidate}"
  if [ -e "${candidate}" ]; then
    # -L forces each of these through the symlink. Without it, Homebrew's
    # bin entry reports "symbolic link to ../Cellar/..." and every type,
    # size and mode below describes the link rather than the image.
    ls -l "${candidate}"
    ls -lL "${candidate}"
    stat -f "%N -> %Y" "${candidate}"
    echo "stat link exit: $?"
    stat -L -f "%Sp %Su:%Sg %z %N" "${candidate}"
    file -bL "${candidate}"
    shasum -a 256 "${candidate}"

    echo "-- wrapper body: ${candidate}"
    CANDIDATE_TYPE="$(file -bL "${candidate}")"
    case "${CANDIDATE_TYPE}" in
      *text*)
        # Read only to discover the versioned libexec target. Recorded in the
        # Vault note only; the wrapper path is never written into a manifest
        # as if it were the executable image.
        head -c 4096 "${candidate}"
        ;;
      *)
        echo "not a text file after following links; wrapper body not read"
        ;;
    esac
  else
    echo "absent"
  fi
done

# --------------------------------------------------- A5 temporary discovery
# On M1 this locates the build tree whose path was never recorded, and its
# output supplies Pass 2's source-tree list. On Intel it confirms whether the
# recorded temporary directories still exist. EACCES on another user's 0700
# directory here is normal and is excluded from the abort conditions.
echo "== A5 private tmp listing"
ls -la /private/tmp
echo "ls tmp exit: $?"

echo "== A5 package manifests"
# Depth 4, not 2: the comparable audit tree places Package.resolved three
# levels below the temporary root.
find /private/tmp -maxdepth 4 -name 'Package.resolved' -print
echo "find Package.resolved exit: $?"
find /private/tmp -maxdepth 4 -name 'Package.swift' -print
echo "find Package.swift exit: $?"

echo "== A5 build dirs"
find /private/tmp -maxdepth 4 -type d -name '.build' -print
echo "find build exit: $?"

echo "== phase-a pass1 end"
