+import Foundation
+import Testing
+
+@testable import IMsgCore
+@testable import imsg
+
+#if os(macOS)
+  private final class BatchTestSource: @unchecked Sendable {
+    private let lock = NSLock()
+    private var authorization: ContactCatalogAuthorization = .authorized
+    private var authorizationCalls = 0
+
+    var source: ContactCatalogSource {
+      ContactCatalogSource(
+        authorization: { [self] in
+          lock.withLock {
+            authorizationCalls += 1
+            return authorization
+          }
+        },
+        load: {
+          [ContactCatalogRecord(
+            name: "Alice", phones: ["+15551234567"], emails: ["alice@example.com"])
+          ]
+        },
+        observeChanges: { _ in {} }
+      )
+    }
+
+    func revoke() { lock.withLock { authorization = .unavailable } }
+    func resetAuthorizationCalls() { lock.withLock { authorizationCalls = 0 } }
+    var observedAuthorizationCalls: Int { lock.withLock { authorizationCalls } }
+  }
+
+  @Test
+  func finalizationRemovesAllContactFieldsAfterObservedRevocation() throws {
+    let source = BatchTestSource()
+    let resolver = ContactResolver(region: "US", source: source.source)
+    let batch = resolver.contactNameBatch(for: ["+15551234567", "alice@example.com"])
+    #expect(batch.isValid())
+    let payloads: [[String: Any]] = [[
+      "contact_name": "Alice",
+      "sender_name": "Alice",
+      "body": "fixture-only",
+      "reactions": [[
+        "sender_name": "Alice", "sender": "alice@example.com", "is_from_me": false,
+      ]],
+    ]]
+
+    source.revoke()
+    let actual = finalizeReadContactNames(payloads, batch: batch)
+    let first = try #require(actual.first)
+    #expect(first["contact_name"] == nil)
+    #expect(first["sender_name"] == nil)
+    #expect(first["body"] as? String == "fixture-only")
+    let reaction = try #require((first["reactions"] as? [[String: Any]])?.first)
+    #expect(reaction["sender_name"] == nil)
+    #expect(reaction["sender"] as? String == "alice@example.com")
+  }
+
+  @Test
+  func rpcHistoryUsesOneBatchRatherThanPerMessageScalarSnapshots() async throws {
+    let store = try CommandTestDatabase.makeStoreForRPCDirectChat()
+    _ = try store.withConnection { db in
+      try db.run("UPDATE chat SET chat_identifier = '+15551234567', guid = 'iMessage;-;+15551234567' WHERE ROWID = 1")
+      try db.run("UPDATE handle SET id = '+15551234567' WHERE ROWID = 1")
+      for rowID in 6...10 {
+        try db.run(
+          "INSERT INTO message(ROWID, handle_id, text, date, is_from_me, service) VALUES (?, 1, 'fixture', ?, 0, 'iMessage')",
+          rowID, Int64(rowID) * 1_000_000_000
+        )
+        try db.run("INSERT INTO chat_message_join(chat_id, message_id) VALUES (1, ?)", rowID)
+      }
+    }
+    let source = BatchTestSource()
+    let resolver = ContactResolver(region: "US", source: source.source, refreshInterval: 60)
+    let output = TestRPCOutput()
+    let server = RPCServer(store: store, verbose: false, output: output, contactResolver: resolver)
+
+    source.resetAuthorizationCalls()
+    await server.handleLineForTesting(
+      #"{"jsonrpc":"2.0","id":"history","method":"messages.history","params":{"chat_id":1,"limit":50,"attachments":false}}"#)
+
+    let result = try #require(output.responses.first?["result"] as? [String: Any])
+    let messages = try #require(result["messages"] as? [[String: Any]])
+    #expect(messages.count == 6)
+    #expect(messages.allSatisfy { $0["sender_name"] as? String == "Alice" })
+    // Cold load checks authorization before/during/after loading, then the
+    // response boundary validates once. The count does not grow by messages.
+    #expect(source.observedAuthorizationCalls == 4)
+  }
+
+  @Test
+  func rpcGroupOnlyChatsSkipContactSnapshot() async throws {
+    let store = try CommandTestDatabase.makeStoreForRPC()
+    let source = BatchTestSource()
+    let resolver = ContactResolver(region: "US", source: source.source, refreshInterval: 60)
+    let output = TestRPCOutput()
+    let server = RPCServer(store: store, verbose: false, output: output, contactResolver: resolver)
+
+    source.resetAuthorizationCalls()
+    await server.handleLineForTesting(
+      #"{"jsonrpc":"2.0","id":"groups","method":"chats.list","params":{"limit":1}}"#)
+
+    #expect(output.errors.isEmpty)
+    #expect(source.observedAuthorizationCalls == 0)
+  }
+#endif
