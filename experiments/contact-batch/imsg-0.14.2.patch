+/// This adapter is scoped to one read request. It deliberately cannot search
+/// contacts or observe availability: doing either would add a second snapshot.
+private final class BatchContactResolver: ContactResolving, @unchecked Sendable {
+  private let names: [String: String]
+
+  init(_ batch: ContactNameBatch) { names = batch.names }
+
+  var contactsUnavailable: Bool { false }
+  func displayName(for handle: String) -> String? { names[handle] }
+  func displayNames(for handles: [String]) -> [String: String] {
+    var resolved: [String: String] = [:]
+    for handle in handles where names[handle] != nil { resolved[handle] = names[handle] }
+    return resolved
+  }
+  func searchByName(_ query: String) -> [ContactMatch] { [] }
+}
+
+private func stableUnique(_ handles: [String]) -> [String] {
+  var seen = Set<String>()
+  return handles.filter { seen.insert($0).inserted }
+}
+
+private func batchForRead(
+  handles: [String], contacts: any ContactResolving
+) -> (batch: ContactNameBatch?, resolver: any ContactResolving) {
+  #if os(macOS)
+  guard !handles.isEmpty, let owner = contacts as? ContactResolver else {
+    return (nil, contacts)
+  }
+  let batch = owner.contactNameBatch(for: stableUnique(handles))
+  return (batch, BatchContactResolver(batch))
+  #else
+    _ = handles
+    return (nil, contacts)
+  #endif
+}
+
+/// The common finalization boundary used by both read handlers. It is
+/// synchronous: state changes after this observation are not claimed seen.
+func finalizeReadContactNames(
+  _ payloads: [[String: Any]], batch: ContactNameBatch?
+) -> [[String: Any]] {
+  guard let batch, !batch.isValid() else { return payloads }
+  return payloads.map { payload in
+    var sanitized = payload
+    sanitized.removeValue(forKey: "contact_name")
+    sanitized.removeValue(forKey: "sender_name")
+    if var reactions = sanitized["reactions"] as? [[String: Any]] {
+      reactions = reactions.map { reaction in
+        var sanitizedReaction = reaction
+        sanitizedReaction.removeValue(forKey: "sender_name")
+        return sanitizedReaction
+      }
+      sanitized["reactions"] = reactions
+    }
+    return sanitized
+  }
+}
